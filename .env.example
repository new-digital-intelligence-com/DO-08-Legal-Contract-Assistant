# ── The model ───────────────────────────────────────────────────────────────
# Anthropic powers the contract review, the drafting and the policy answers.
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Haiku 4.5 — fast, cheap, and it reads PDFs natively, which is what the
# document work needs. It is a 200K-context model, so the page ceiling the app
# enforces is 100 pages per PDF rather than 600.
#
# The app adapts its request shape to whichever model is named here, because
# the families do not take the same parameters: Haiku 4.5 rejects
# `output_config.effort` and adaptive thinking and accepts `temperature`, while
# Opus 5 and the 4.6+ family are the exact opposite. Set this to
# `claude-opus-5` for deeper review on hard agreements — nothing else has to
# change; see `MODEL_TRAITS` in src/lib/anthropic.ts.
ANTHROPIC_MODEL=claude-haiku-4-5

# ── The people ──────────────────────────────────────────────────────────────
# Who this app acts as. Every audit entry and every upload is attributed to
# this address, so it must be a real person while there is no sign-in.
REVIEWER_EMAIL=

# Counsel who signs off. Must not be the reviewer — the whole point is that a
# qualified person takes each position before anything is sent to a
# counterparty. Shown on every review awaiting sign-off.
LEGAL_EMAIL=

# The organisation the playbook belongs to. Appears on every review header.
ORG_NAME=New Digital Intelligence

# ── Google Drive ────────────────────────────────────────────────────────────
# The shared folder every contract and every review lands in:
#
#   <GOOGLE_DRIVE_FOLDER_ID>/
#     input/     the contract PDFs, exactly as uploaded
#     output/    <contract>-review.md and .json, one pair per review
#     state/     the register — contracts, reviews, standards, drafts, audit
#
# The scope requested is the full `drive` scope, not the narrower `drive.file`.
# That is forced by the folder being configuration: `drive.file` only ever
# reaches files the app itself created, so it cannot see a folder somebody else
# made — and it fails in the worst possible way, listing that folder's contents
# as an empty array with a 200. "No contracts here" and "cannot see this
# folder" are opposite facts and Drive reports them identically. The app probes
# the folder explicitly before believing an empty result.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback
# Written here automatically after visiting /api/drive/connect once and
# approving. Until it is set, contracts are reviewed and kept locally and the
# console says plainly that nothing has reached Drive yet.
GOOGLE_REFRESH_TOKEN=
